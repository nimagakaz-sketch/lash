# Telegram Bot Token от @BotFather (необходим для работы бота и валидации initData)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Публичный URL вашего приложения на Render (или ngrok / localtunnel для тестов)
WEBAPP_URL=https://beauty-bot.onrender.com

# Telegram ID мастера / администраторов (через запятую) для уведомлений и доступа в Кабинет
ADMIN_IDS=123456789,987654321

# Порт приложения (на Render подставляется автоматически из $PORT)
PORT=8000

# Окружение (development / production)
ENVIRONMENT=development

# Supabase (Опционально: если пусто, используется локальная база данных SQLite beauty.db)
SUPABASE_URL=
SUPABASE_KEY=
